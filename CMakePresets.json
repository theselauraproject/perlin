{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-clang-cl",
      "displayName": "Windows x64 (clang-cl, Ninja)",
      "description": "clang-cl + lld-link. Run from a Developer PowerShell / x64 Native Tools prompt, or open the folder in Visual Studio or VS Code, which set up the environment for you.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "windows-clang-cl-debug",
      "displayName": "Windows x64 (clang-cl, Ninja, Debug)",
      "inherits": "windows-clang-cl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-clang-cl-fast",
      "displayName": "Windows x64 (clang-cl, Ninja, Release without LTO)",
      "description": "Same as windows-clang-cl without link-time optimisation or the extra Release flags, for much quicker local builds.",
      "inherits": "windows-clang-cl",
      "cacheVariables": {
        "PERLIN_LTO": "OFF",
        "PERLIN_MAX_OPT": "OFF"
      }
    },
    {
      "name": "windows-vs-clangcl",
      "displayName": "Windows x64 (Visual Studio solution, ClangCL toolset)",
      "description": "Generates a Visual Studio solution that compiles with clang-cl.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": "x64",
      "toolset": "ClangCL",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2026-clangcl",
      "displayName": "Windows x64 (Visual Studio 2026 solution, ClangCL toolset)",
      "description": "Generates a Visual Studio 2026 solution that compiles with clang-cl.",
      "inherits": "windows-vs-clangcl",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "unix-ninja",
      "displayName": "Linux / macOS (Ninja, Release)",
      "description": "Release build with the self-tests enabled. Needs the system packages listed in README.md.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PERLIN_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      }
    },
    {
      "name": "unix-ninja-fast",
      "displayName": "Linux / macOS (Ninja, Release without LTO, self-tests)",
      "inherits": "unix-ninja",
      "cacheVariables": {
        "PERLIN_LTO": "OFF",
        "PERLIN_MAX_OPT": "OFF"
      }
    },
    {
      "name": "unix-ninja-debug",
      "displayName": "Linux / macOS (Ninja, Debug)",
      "inherits": "unix-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "unix-ninja-asan",
      "displayName": "Linux / macOS (Ninja, ASan + UBSan)",
      "inherits": "unix-ninja-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl"
    },
    {
      "name": "windows-clang-cl-debug",
      "configurePreset": "windows-clang-cl-debug"
    },
    {
      "name": "windows-clang-cl-fast",
      "configurePreset": "windows-clang-cl-fast"
    },
    {
      "name": "windows-vs-clangcl",
      "configurePreset": "windows-vs-clangcl",
      "configuration": "Release",
      "nativeToolOptions": [
        "/m"
      ]
    },
    {
      "name": "windows-vs2026-clangcl",
      "configurePreset": "windows-vs2026-clangcl",
      "configuration": "Release",
      "nativeToolOptions": [
        "/m"
      ]
    },
    {
      "name": "unix-ninja",
      "configurePreset": "unix-ninja"
    },
    {
      "name": "unix-ninja-debug",
      "configurePreset": "unix-ninja-debug"
    },
    {
      "name": "unix-ninja-asan",
      "configurePreset": "unix-ninja-asan"
    },
    {
      "name": "unix-ninja-fast",
      "configurePreset": "unix-ninja-fast"
    }
  ],
  "testPresets": [
    {
      "name": "unix-ninja",
      "configurePreset": "unix-ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "unix-ninja-debug",
      "configurePreset": "unix-ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "unix-ninja-asan",
      "configurePreset": "unix-ninja-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "unix-ninja-fast",
      "configurePreset": "unix-ninja-fast",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
