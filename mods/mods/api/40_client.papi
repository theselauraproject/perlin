op Log = 0x0001 @hosts(client, server) @category(core) (level: LogLevel, text: string);
op Meta = 0x0002 @hosts(client) @category(core) -> Meta;
op Clock = 0x0003 @hosts(client, server) @category(core) -> i64;

op PlayerState = 0x0100 @hosts(client) @category(player) @hot -> PlayerState;
op PlayerEffects = 0x0101 @hosts(client) @category(player) -> (effects: list<Effect>);
op PlayerLook = 0x0102 @hosts(client) @category(player) -> (yaw: f32, pitch: f32);

op Inventory = 0x0200 @hosts(client) @category(inventory) -> Inventory;
op InventorySelect = 0x0201 @hosts(client) @permission(Control) @category(inventory) (slot: i32);
op InventoryDrop = 0x0202 @hosts(client) @permission(Control) @category(inventory) (count: i32 @doc("1 to 64 items from the selected slot"));
op InventorySwap = 0x0203 @hosts(client) @permission(Control) @category(inventory) (a: i32, b: i32);
op InventoryClick = 0x0204 @hosts(client) @permission(Control) @category(inventory) (slot: i32, right: bool, shift: bool);
op InventoryOpen = 0x0205 @hosts(client) @permission(Control) @category(inventory);
op InventoryClose = 0x0206 @hosts(client) @permission(Control) @category(inventory);

op WorldState = 0x0300 @hosts(client) @category(world) -> WorldState;
op Block = 0x0301 @hosts(client) @category(world) @hot (x: i32, y: i32, z: i32) -> BlockInfo;
op Region = 0x0302 @hosts(client) @category(world) (x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32) -> Region;
op Raycast = 0x0303 @hosts(client) @category(world) (ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, maxDistance: f64, liquids: bool) -> RayHit;
op Aim = 0x0304 @hosts(client) @category(world) -> AimState;
op FindBlocks = 0x0305 @hosts(client) @category(world) (x: i32, y: i32, z: i32, radius: i32, limit: i32, exact: bool, name: string) -> (blocks: list<FoundBlock>);
op ChunkLoaded = 0x0306 @hosts(client) @category(world) (x: i32, z: i32) -> bool;
op BlockNames = 0x0307 @hosts(client) @category(world) -> (names: list<string>);
op BlockProps = 0x0308 @hosts(client) @category(world) (name: string) -> BlockProps;
op BlockEntityData = 0x0309 @hosts(client) @category(world) (x: i32, y: i32, z: i32) -> BlockEntityInfo;
op DisplayName = 0x030A @hosts(client) @category(world) (kind: NameKind, id: string, aux: i32) -> rest_text;
op BreakProgress = 0x030B @hosts(client) @category(world) -> BreakState;
op MapChunk = 0x030C @hosts(client) @category(world) (x: i32, z: i32, caveY: i32) -> rest_bytes @doc("bool fresh, u64 version, then the column grid: see mods/docs/map-chunk.md");

op Entities = 0x0400 @hosts(client) @category(entity) (radius: f64, type: string, playersOnly: bool, includeItems: bool) -> (entities: list<Entity>);
op EntityById = 0x0401 @hosts(client) @category(entity) (id: u64) -> Entity;
op PlayerList = 0x0402 @hosts(client) @category(entity) -> (players: list<PlayerEntry>);

op Options = 0x0500 @hosts(client) @category(options) -> rest_text @doc("every option as one JSON object");
op OptionGet = 0x0501 @hosts(client) @category(options) (key: string) -> rest_text;
op OptionSet = 0x0502 @hosts(client) @permission(Control) @category(options) (key: string, value: string);
op Screen = 0x0503 @hosts(client) @category(ui) -> ScreenState;
op Translate = 0x0504 @hosts(client) @category(ui) (key: string) -> rest_text;
op ReloadResources = 0x0505 @hosts(client) @permission(Control) @category(resources);
op PerspectiveGet = 0x0506 @hosts(client) @category(camera) -> Perspective;
op PerspectiveSet = 0x0507 @hosts(client) @category(camera) (perspective: Perspective);
op ResourcePacks = 0x0508 @hosts(client) @category(resources) -> (packs: list<PackEntry>);

op InputDown = 0x0600 @hosts(client) @category(input) (name: string) -> bool;
op InputOverride = 0x0601 @hosts(client) @permission(Control) @category(input) InputOverrideState;
op KeyRegister = 0x0602 @hosts(client) @category(input) (id: string, label: string, fallback: string);
op InputActions = 0x0603 @hosts(client) @category(input) -> (actions: list<string>);
op MousePosition = 0x0604 @hosts(client) @category(input) -> (x: f32, y: f32, captured: bool);

op Chat = 0x0700 @hosts(client) @permission(Control) @category(chat) (text: string);
op Command = 0x0701 @hosts(client) @permission(Control) @category(chat) (line: string);
op LocalMessage = 0x0702 @hosts(client) @category(chat) (text: string);
op CommandRegister = 0x0703 @hosts(client, server) @category(chat) (name: string, usage: string, description: string);
op CommandUnregister = 0x0704 @hosts(client, server) @category(chat) (name: string);
op ServerCommands = 0x0705 @hosts(client) @category(chat) -> (names: list<string>);
op Toast = 0x0706 @hosts(client) @category(ui) (text: string, ms: i32 @unit("ms"));
op Title = 0x0707 @hosts(client) @category(ui) (title: string, subtitle: string, fadeIn: i32, stay: i32, fadeOut: i32);
op ChatHistory = 0x0708 @hosts(client) @category(chat) (count: u32 @max(100)) -> (lines: list<ChatLine>);
op TitleState = 0x0709 @hosts(client) @category(ui) -> TitleStateData;

op SwingArm = 0x0800 @hosts(client) @permission(Control) @category(action);
op UseItem = 0x0801 @hosts(client) @permission(Control) @category(action);
op UseOnBlock = 0x0802 @hosts(client) @permission(Control) @category(action) (x: i32, y: i32, z: i32, face: Face);
op AttackEntity = 0x0803 @hosts(client) @permission(Control) @category(action) (entity: u64);
op InteractEntity = 0x0804 @hosts(client) @permission(Control) @category(action) (entity: u64);
op BreakBlock = 0x0805 @hosts(client) @permission(Control) @category(action) (x: i32, y: i32, z: i32, face: Face);
op Look = 0x0806 @hosts(client) @permission(Control) @category(action) (yaw: f32, pitch: f32);
op Respawn = 0x0807 @hosts(client) @permission(Control) @category(action);
op Disconnect = 0x0808 @hosts(client) @permission(Control) @category(action);
op PlaySound = 0x0809 @hosts(client) @category(audio) (name: string, positional: bool, x: f32, y: f32, z: f32, volume: f32, pitch: f32);
op Jump = 0x080B @hosts(client) @permission(Control) @category(action);

op UiSubmit = 0x0900 @hosts(client) @category(ui) @hot (layer: string, z: i32, commands: bytes);
op UiClear = 0x0901 @hosts(client) @category(ui) (layer: string);
op UiMeasure = 0x0902 @hosts(client) @category(ui) (text: string, scale: f32) -> f32;
op GfxTextureCreate = 0x0910 @hosts(client) @category(gfx) (width: i32, height: i32, linear: bool, rgba: bytes) -> u32;
op GfxTextureUpdate = 0x0911 @hosts(client) @category(gfx) @hot (id: u32, x: i32, y: i32, width: i32, height: i32, rgba: bytes);
op GfxTextureDestroy = 0x0912 @hosts(client) @category(gfx) (id: u32);
op GfxSubmit = 0x0913 @hosts(client) @category(gfx) @hot (layer: string, z: i32, blob: bytes @doc("GfxHeader, GfxVertex[], indices, GfxCmd[]"));
op GfxClear = 0x0914 @hosts(client) @category(gfx) (layer: string);
op GfxDisplay = 0x0915 @hosts(client) @category(gfx) -> GfxDisplayInfo;
op GfxImageLoad = 0x0916 @hosts(client) @category(gfx) (path: string) -> (width: i32, height: i32, rgba: bytes);
op InputGrab = 0x0920 @hosts(client) @permission(Control) @category(input) (mouse: bool, keyboard: bool);
op NativeInfo = 0x0930 @hosts(client) @permission(Native) @category(gfx) -> NativeHandles;

op StorageRead = 0x0A00 @hosts(client, server) @permission(Storage) @category(storage) (path: string) -> rest_bytes;
op StorageWrite = 0x0A01 @hosts(client, server) @permission(Storage) @category(storage) (path: string, data: bytes);
op StorageList = 0x0A02 @hosts(client, server) @permission(Storage) @category(storage) (path: string) -> (names: list<string>);
op StorageRemove = 0x0A03 @hosts(client, server) @permission(Storage) @category(storage) (path: string);
op StorageExists = 0x0A04 @hosts(client, server) @permission(Storage) @category(storage) (path: string) -> bool;
op StorageMakeDir = 0x0A05 @hosts(client, server) @permission(Storage) @category(storage) (path: string);

op HttpRequest = 0x0B00 @hosts(client, server) @permission(Network) @category(network) (id: u32, method: string, url: string, timeoutMs: i32, headers: list<pair<string, string>>, body: bytes) @doc("the answer arrives as the HttpResponse event with the same id");
op PacketSend = 0x0B01 @hosts(client) @permission(Packets) @category(network) (id: u32, body: bytes);
op PacketName = 0x0B02 @hosts(client) @category(network) (id: u32) -> rest_text;

op SettingGet = 0x0C01 @hosts(client, server) @category(settings) (id: string) -> rest_text;
op SettingSet = 0x0C02 @hosts(client, server) @category(settings) (id: string, value: string);
op SettingList = 0x0C03 @hosts(client, server) @category(settings) -> (settings: list<SettingEntry>);
op ModList = 0x0C10 @hosts(client, server) @category(mods) -> (mods: list<ModEntry>);
op IconSet = 0x0C11 @hosts(client) @category(mods) (path: string);

op OpenScreen = 0x0D00 @hosts(client) @category(ui) (screen: Screen);
op OpenModSettings = 0x0D01 @hosts(client) @category(ui) (mod: string);
op TakeScreenshot = 0x0D02 @hosts(client) @category(ui);
op CyclePerspective = 0x0D03 @hosts(client) @category(camera);
op CopyToClipboard = 0x0D04 @hosts(client) @category(ui) (text: string);
op OpenUrl = 0x0D05 @hosts(client) @permission(Network) @category(ui) (url: string);
op ToggleHud = 0x0D06 @hosts(client) @category(ui);

op CopyFile = 0x0E00 @hosts(client) @permission(Files) @category(storage) (from: FileLocation, to: FileLocation);
op MoveFile = 0x0E01 @hosts(client) @permission(Files) @category(storage) (from: FileLocation, to: FileLocation);
op DownloadFile = 0x0E02 @hosts(client) @permission(Network, Files) @category(storage) (id: u32, url: string, to: FileLocation);

op CameraControl = 0x0F00 @hosts(client) @permission(Control) @category(camera) CameraControlState;
op CameraState = 0x0F01 @hosts(client) @category(camera) -> CameraInfo;
op WorldToScreen = 0x0F02 @hosts(client) @category(camera) WorldPoint -> ScreenPoint;
op PlayerMotion = 0x0F10 @hosts(client) @permission(Control) @category(player) MotionRequest;
op PlayerTeleport = 0x0F11 @hosts(client) @permission(Control) @category(player) TeleportRequest;
op PlayerModelPose = 0x0F20 @hosts(client) @permission(Control) @category(player) ModelPose;
op PlayerSetLook = 0x0F21 @hosts(client) @permission(Control) @category(player) LookSet;
op WorldLines = 0x0F30 @hosts(client) @category(render) WorldLines;
op WorldBoxes = 0x0F31 @hosts(client) @category(render) WorldBoxes;
op ClientBlockSet = 0x0F40 @hosts(client) @permission(Control) @category(world) ClientBlockEdits;
op ClientBlockGet = 0x0F41 @hosts(client) @category(world) BlockQuery -> BlockQueryResult;
op PacketDrop = 0x0F50 @hosts(client) @permission(Packets, Control) @category(network) PacketDropRequest;
op PacketCounters = 0x0F51 @hosts(client) @category(network) -> (counters: list<PacketCount>);
op PacketInject = 0x0F52 @hosts(client) @permission(Packets, Control) @category(network) (id: u32, body: bytes);

op HudElementSet = 0x1000 @hosts(client) @category(ui) HudElementState;
op DebugLines = 0x1001 @hosts(client) @category(ui) DebugLinesData;
op FogSet = 0x1002 @hosts(client) @category(render) FogOverride;
op ScreenTint = 0x1003 @hosts(client) @category(render) ScreenTintData;
op EntityRenderOverride = 0x1010 @hosts(client) @category(render) EntityOverride;
op WorldMesh = 0x1011 @hosts(client) @category(render) WorldMeshData;
op WorldMeshClear = 0x1012 @hosts(client) @category(render) (id: string);
op FrameLimit = 0x1020 @hosts(client) @category(render) FrameLimitData;
op WindowState = 0x1021 @hosts(client) @category(ui) -> WindowInfo;
op ScreenButtonAdd = 0x1030 @hosts(client) @category(ui) ScreenButtonDef;
op ScreenButtonRemove = 0x1031 @hosts(client) @category(ui) (id: string);
op ScreenOpenCustom = 0x1032 @hosts(client) @category(ui) (id: string);
op TooltipAppend = 0x1033 @hosts(client) @category(ui) (lines: list<string>);
op LoadingOverlay = 0x1040 @hosts(client) @category(ui) LoadingOverlayData;
op SkinOverride = 0x1041 @hosts(client) @category(render) SkinOverrideData;
op AmbientSound = 0x1050 @hosts(client) @category(audio) AmbientSoundData;
op ServerPing = 0x1060 @hosts(client) @permission(Network) @category(network) ServerPingRequest -> u32 @doc("request id; the answer arrives as the ServerPing event");
op ModSend = 0x1070 @hosts(client, server) @category(mods) ModMessageData;
op PackRegister = 0x1080 @hosts(client) @permission(Files) @category(resources) PackRegistration;
op ShaderPackSet = 0x1081 @hosts(client) @permission(Control) @category(resources) (name: string);
op ParticleSpawn = 0x1090 @hosts(client) @category(render) ParticleRequest;
op KeyRegisterEx = 0x10A0 @hosts(client) @category(input) KeyBindEx;
