api perlin version 3;

tag doc(text) on any @doc("Human-readable description; every backend copies it into its docs");
tag hosts(name...) on op, event @doc("Which programs answer the call or raise the event: client, server");
tag permission(name...) on op @doc("Permission bits the plugin manifest must grant before the host runs the call");
tag since(int) on any @doc("API version that introduced the declaration");
tag deprecated(text?) on any @doc("Still served, scheduled for removal; the text names the replacement");
tag internal on event @doc("Consumed by the SDK runtime instead of becoming an onName method");
tag cancellable on event @doc("A handler may return cancel; the host then skips the default behaviour");
tag hot on event, op @doc("Raised or called many times per second; bindings should avoid allocations");
tag cpp(text) on struct @doc("Extra C++ members appended to the generated struct");
tag range(int, int) on enum @doc("Valid enumerator range for reflection-based helpers");
tag unit(text) on field @doc("Physical unit of the value: blocks, ticks, ms, degrees, pixels");
tag max(int) on field @doc("Largest accepted length or value; hosts reject anything above it");
tag layout(name) on struct @doc("packed: a binary blob layout with a fixed size, also usable inside bytes fields");
tag size(int) on struct @doc("Expected sizeof for a packed layout");
tag category(name) on op, event @doc("Groups declarations in generated documentation and language modules");
