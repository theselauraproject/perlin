{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-clang-cl",
      "displayName": "Windows x64 (clang-cl, Ninja)",
      "description": "clang-cl + lld-link. Run from a Developer PowerShell / x64 Native Tools prompt, or open the folder in Visual Studio or VS Code, which set up the environment for you.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ], "intelliSenseMode": "windows-clang-x64" }
      }
    },
    {
      "name": "windows-clang-cl-debug",
      "displayName": "Windows x64 (clang-cl, Ninja, Debug)",
      "inherits": "windows-clang-cl",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-vs-clangcl",
      "displayName": "Windows x64 (Visual Studio solution, ClangCL toolset)",
      "description": "Generates a Visual Studio solution that compiles with clang-cl.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": "x64",
      "toolset": "ClangCL",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl" },
    { "name": "windows-clang-cl-debug", "configurePreset": "windows-clang-cl-debug" },
    { "name": "windows-vs-clangcl", "configurePreset": "windows-vs-clangcl", "configuration": "Release" }
  ]
}
