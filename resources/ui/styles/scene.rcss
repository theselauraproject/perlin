.n {
    display: block;
    position: absolute;
}

.n > mcimg,
.n > mcitem,
.n > .fill {
    display: block;
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}

.n > .tx {
    display: block;
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    white-space: pre;
    overflow: visible;
}

.n.clip {
    overflow: hidden;
    clip: always;
}

.n.clip > .lab {
    position: static;
}

.n > .lab {
    display: block;
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
}

.n.auto > .lab {
    position: static;
    width: auto;
}
