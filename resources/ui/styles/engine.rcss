mcimg,
mcitem {
    display: block;
    position: absolute;
}

.t {
    display: block;
    position: absolute;
    font-family: minecraft;
    white-space: pre;
    overflow: visible;
}

.t.s {
    font-family: minecraft-shadow;
}

.t.o {
    font-family: minecraft-outline;
}

.t.ten {
    font-family: minecraft-ten;
}

.t.ten.s {
    font-family: minecraft-ten-shadow;
}

.t.ten.o {
    font-family: minecraft-ten-outline;
}

.link {
    display: block;
    position: absolute;
}

.link .ul {
    display: none;
    position: absolute;
    left: 0px;
    bottom: 0px;
    width: 100%;
    height: 1px;
    background-color: #ffff55;
}

.link:hover .ul {
    display: block;
}

.df {
    display: block;
}

.bt .hv {
    display: none;
}

.bt:hover .hv {
    display: block;
}

.bt:hover .df {
    display: none;
}

body * {
    pointer-events: none;
}

.bt,
.bt *,
.link,
.link * {
    pointer-events: auto;
}
