<rml>
    <head>
        <title>creative</title>
        <style>
            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            mcitem {
                display: block;
                position: absolute;
            }

            mcimg {
                display: block;
                position: absolute;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                decorator: vertical-gradient( rgba(16,16,16,192) rgba(16,16,16,208) );
            }

            #panel {
                left: {{x}}px;
                top: {{y}}px;
                width: 195px;
                height: 136px;
                z-index: 2;
            }

            .tab {
                width: 26px;
                height: 32px;
            }

            .tab.off {
                z-index: 1;
            }

            .tab.on {
                z-index: 3;
            }

            .ticon {
                width: 16px;
                height: 16px;
                z-index: 4;
                pointer-events: none;
            }

            .label {
                font-family: minecraft;
                font-size: 8px;
                line-height: 9px;
                color: #404040;
                white-space: nowrap;
                z-index: 3;
            }

            .search {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
                z-index: 3;
            }

            .fx {
                z-index: 2;
            }

            .fxn {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
                z-index: 4;
            }

            .fxd {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #7f7f7f;
                white-space: nowrap;
                z-index: 4;
            }

            .slot {
                width: 18px;
                height: 18px;
                z-index: 3;
            }

            .slot .hl {
                display: none;
                left: 1px;
                top: 1px;
                width: 16px;
                height: 16px;
                background-color: rgba(255,255,255,128);
                z-index: 5;
                pointer-events: none;
            }

            .slot:hover .hl {
                display: block;
            }

            .slot mcitem {
                z-index: 4;
            }

            .cnt {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                text-align: right;
                white-space: nowrap;
                z-index: 6;
            }

            #scroll {
                width: 12px;
                height: 15px;
                z-index: 3;
            }

            #sbar {
                width: 14px;
                height: 112px;
                z-index: 3;
            }

            #cursor {
                z-index: 30;
                pointer-events: none;
                width: 16px;
                height: 16px;
            }

            #cursor .cnt {
                z-index: 31;
            }

            {{include:ui/styles/tooltip.rcss}}
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

  <div id="dim"></div>
  <div id="panel">{{scene:chrome}}</div>
  {{scene:tabs}}
  {{scene:effects}}
  {{scene:search}}
  {{scene:scrollbar}}
  {{scene:slots}}
  <div id="top" style="left: 0px; top: 0px; width: {{w}}px; height: {{h}}px; z-index: 50; pointer-events: none;"><mclayer layer="top" style="display: block; position: absolute; width: 0px; height: 0px; z-index: -999;"></mclayer>{{scene:cursor}}{{scene:tooltip}}<mclayer layer="gui" style="display: block; position: absolute; width: 0px; height: 0px; z-index: 999;"></mclayer></div>
</div>
    </body>
</rml>
