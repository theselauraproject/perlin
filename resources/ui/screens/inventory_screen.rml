<rml>
    <head>
        <title>inventory</title>
        <style>
            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            mcitem,
            mcimg {
                display: block;
                position: absolute;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                background-color: rgba(16,16,16,200);
            }

            #panel {
                left: {{x}}px;
                top: {{y}}px;
                width: 176px;
                height: 166px;
            }

            .r {
                position: absolute;
            }

            .label {
                font-family: minecraft;
                font-size: 8px;
                line-height: 9px;
                color: #404040;
                white-space: nowrap;
            }

            .slot {
                width: 18px;
                height: 18px;
                z-index: 2;
            }

            .slot .hl {
                display: none;
                left: 1px;
                top: 1px;
                width: 16px;
                height: 16px;
                background-color: rgba(255,255,255,128);
                z-index: 5;
                pointer-events: none;
            }

            .slot:hover .hl {
                display: block;
            }

            .slot mcitem {
                z-index: 4;
            }

            .cnt {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                text-align: right;
                white-space: nowrap;
                z-index: 6;
            }

            #cursor {
                z-index: 30;
                pointer-events: none;
                width: 16px;
                height: 16px;
            }

            #cursor .cnt {
                z-index: 31;
            }

            .rbtn {
                width: 20px;
                height: 18px;
                z-index: 6;
            }

            .rbtn .rh {
                display: none;
                left: 0px;
                top: 0px;
            }

            .rbtn:hover .rh {
                display: block;
            }

            .rbtn .rn {
                left: 0px;
                top: 0px;
            }

            .fx {
                z-index: 2;
            }

            .fxn {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
                z-index: 4;
            }

            .fxd {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #7f7f7f;
                white-space: nowrap;
                z-index: 4;
            }

            .rc {
                width: 25px;
                height: 25px;
                z-index: 3;
            }

            .rc mcitem {
                z-index: 4;
            }

            .pg {
                width: 12px;
                height: 17px;
                z-index: 6;
            }

            .pg .ph {
                display: none;
                left: 0px;
                top: 0px;
            }

            .pg:hover .ph {
                display: block;
            }

            {{include:ui/styles/tooltip.rcss}}
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

  <div id="dim"></div>
  {{scene:book}}
  {{scene:effects}}
  <div id="panel">{{scene:chrome}}</div>
  {{scene:bookbutton}}
  {{scene:slots}}
  <div id="top" style="left: 0px; top: 0px; width: {{w}}px; height: {{h}}px; z-index: 50; pointer-events: none;"><mclayer layer="top" style="display: block; position: absolute; width: 0px; height: 0px; z-index: -999;"></mclayer>{{scene:cursor}}{{scene:tooltip}}<mclayer layer="gui" style="display: block; position: absolute; width: 0px; height: 0px; z-index: 999;"></mclayer></div>
</div>
    </body>
</rml>
