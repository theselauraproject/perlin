<rml>
    <head>
        <title>chest</title>
        <style>
            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            .cnt {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                text-align: right;
                white-space: nowrap;
                z-index: 6;
            }

            #cursor {
                z-index: 30;
                pointer-events: none;
                width: 16px;
                height: 16px;
            }

            #cursor .cnt {
                z-index: 31;
            }

            {{include:ui/styles/tooltip.rcss}}{{rcss}}
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

{{scene:hud}}
<div id="top" style="left: 0px; top: 0px; width: {{w}}px; height: {{h}}px; z-index: 1000; pointer-events: none;"><mclayer layer="top" style="display: block; position: absolute; width: 0px; height: 0px; z-index: -999;"></mclayer>{{scene:cursor}}{{scene:tooltip}}<mclayer layer="gui" style="display: block; position: absolute; width: 0px; height: 0px; z-index: 999;"></mclayer></div>
</div>
    </body>
</rml>
