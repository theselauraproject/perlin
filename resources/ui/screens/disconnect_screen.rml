<rml>
    <head>
        <title>disconnect</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            mcimg {
                display: block;
                position: absolute;
            }

            #heading {
                left: 0px;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
                z-index: 3;
            }

            #reason {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                z-index: 3;
            }

            #code {
                left: 0px;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #8a8a8a;
                white-space: nowrap;
                z-index: 3;
            }

            .btn {
                width: 204px;
                height: 20px;
                background-color: #000000;
                z-index: 5;
            }

            .btn div {
                position: absolute;
            }

            .btn .rim {
                left: 1px;
                top: 1px;
                width: 201px;
                height: 16px;
                background-color: #aaaaaa;
            }

            .btn .face {
                left: 2px;
                top: 2px;
                width: 200px;
                height: 15px;
                background-color: #6f6f6f;
            }

            .btn .shade {
                left: 1px;
                top: 17px;
                width: 202px;
                height: 2px;
                background-color: #565656;
            }

            .btn .edge {
                left: 202px;
                top: 1px;
                width: 1px;
                height: 16px;
                background-color: #565656;
            }

            .btn .lbl {
                font-family: minecraft-shadow;
                left: 0px;
                top: 6px;
                width: 204px;
                height: 9px;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
            }

            .btn:hover {
                background-color: #ffffff;
            }

            .btn:hover .rim {
                background-color: #afafaf;
            }

            .btn:hover .face {
                background-color: #757575;
            }

            .btn:hover .shade,
            .btn:hover .edge {
                background-color: #5c5c5c;
            }

            .btn.off,
            .btn.off:hover {
                background-color: #000000;
            }

            .btn.off .rim,
            .btn.off .face,
            .btn.off .shade,
            .btn.off .edge {
                background-color: #2c2c2c;
            }

            .btn.off .lbl {
                color: #a0a0a0;
            }

            {{include:ui/styles/java_widget_style.rcss}}
        </style>
    </head>
    <body>
        <div data-model="overlay" data-style-width="w + 'px'" data-style-height="h + 'px'">
            <div data-if="panorama">
                {{include:ui/components/menu_backdrop_panorama.rml}}
            </div>
            <div data-if="!panorama">
                {{include:ui/components/menu_backdrop_tiled.rml}}
            </div>
            <div id="heading" data-style-top="title_y + 'px'" data-style-width="w + 'px'">
                <span data-for="r : title_runs">
                    <span
                        data-style-color="r.color == '' ? 'inherit' : r.color"
                        data-style-font-weight="r.weight"
                        data-style-font-style="r.style"
                        data-style-background-color="r.background"
                        data-style-display="r.display"
                        data-style-width="r.width"
                        data-style-overflow="r.overflow">
                        {{r.text}}
                    </span>
                </span>
            </div>
            <div
                id="reason"
                data-style-left="text_x + 'px'"
                data-style-top="text_y + 'px'"
                data-style-width="text_w + 'px'"
                data-style-height="text_h + 'px'">
                <span data-for="r : reason_runs">
                    <span
                        data-style-color="r.color == '' ? 'inherit' : r.color"
                        data-style-font-weight="r.weight"
                        data-style-font-style="r.style"
                        data-style-background-color="r.background"
                        data-style-display="r.display"
                        data-style-width="r.width"
                        data-style-overflow="r.overflow">
                        {{r.text}}
                    </span>
                </span>
            </div>
            <div id="code" data-style-top="code_y + 'px'" data-style-width="w + 'px'">{{code}}</div>
            <div
                id="rejoin"
                class="btn"
                data-class-off="rejoin_off"
                data-style-left="btn_x + 'px'"
                data-style-top="y1 + 'px'">

            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl">{{rejoin}}</div>
        </div>
            <div id="quit" class="btn" data-style-left="btn_x + 'px'" data-style-top="y2 + 'px'">

            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl">{{quit}}</div>
        </div>
            <div
                id="dontask"
                data-if="has_extra"
                class="btn"
                data-style-left="btn_x + 'px'"
                data-style-top="y3 + 'px'">

            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl">{{extra}}</div>
        </div>
        </div>
    </body>
</rml>
