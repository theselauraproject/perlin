<rml>
    <head>
        <title>form</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            mcimg,
            mcitem {
                display: block;
                position: absolute;
            }

            {{chat_style}}{{rcss}}
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">
            {{chat}}{{hud}}
        </div>
    </body>
</rml>
