<rml>
    <head>
        <title>form</title>
        <style>
            body {
                width: 100%;
                height: 100%;
                position: absolute;
                left: 0px;
                top: 0px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            #scene {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            div,
            mcimg {
                display: block;
                position: absolute;
            }

            #bg {
                background-color: rgba(0,0,0,150);
            }

            #panel {
                background-color: rgba(16,16,16,235);
            }

            #clip {
                overflow: hidden;
            }

            .t {
                font-family: minecraft-shadow;
                white-space: pre-line;
                color: #ffffff;
                font-size: 8px;
                line-height: 9px;
            }

            .c {
                text-align: center;
            }

            .btn {
                background-color: #000000;
            }

            .btn div {
                display: block;
                position: absolute;
            }

            .btn .rim {
                background-color: #aaaaaa;
            }

            .btn .face {
                background-color: #6f6f6f;
            }

            .btn .shade {
                background-color: #565656;
            }

            .btn .edge {
                background-color: #565656;
            }

            .btn .lbl {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: pre;
                overflow: hidden;
            }

            .btn:hover {
                background-color: #ffffff;
            }

            .btn:hover .rim {
                background-color: #afafaf;
            }

            .btn:hover .face {
                background-color: #757575;
            }

            .field {
                background-color: #ffffff;
            }

            .field .in {
                background-color: #000000;
            }

            .field.focus .in {
                background-color: #101030;
            }

            .field .txt {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                white-space: nowrap;
                overflow: hidden;
                color: #e0e0e0;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">
            {{scene:body}}
        </div>
    </body>
</rml>
