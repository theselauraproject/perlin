<rml>
    <head>
        <title>options</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            #scene {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,128);
            }

            #heading {
                left: 0px;
                top: 15px;
                width: 100%;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
                z-index: 3;
            }

            .btn {
                height: 20px;
                background-color: #000000;
                z-index: 5;
            }

            .btn div {
                position: absolute;
            }

            .btn .rim {
                left: 1px;
                top: 1px;
                height: 16px;
                background-color: #aaaaaa;
            }

            .btn .face {
                left: 2px;
                top: 2px;
                height: 15px;
                background-color: #6f6f6f;
            }

            .btn .shade {
                left: 1px;
                top: 17px;
                height: 2px;
                background-color: #565656;
            }

            .btn .edge {
                top: 1px;
                width: 1px;
                height: 16px;
                background-color: #565656;
            }

            .btn .lbl {
                font-family: minecraft-shadow;
                left: 0px;
                top: 6px;
                height: 9px;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
            }

            .btn:hover {
                background-color: #ffffff;
            }

            .btn:hover .rim {
                background-color: #afafaf;
            }

            .btn:hover .face {
                background-color: #757575;
            }

            .btn:hover .shade,
            .btn:hover .edge {
                background-color: #5c5c5c;
            }

            .btn.track .rim {
                background-color: #2c2c2c;
            }

            .btn.track .face {
                background-color: #1f1f1f;
            }

            .btn.track:hover {
                background-color: #ffffff;
            }

            .btn.track:hover .rim {
                background-color: #2c2c2c;
            }

            .btn.track:hover .face {
                background-color: #1f1f1f;
            }

            .knob {
                width: 8px;
                height: 20px;
                z-index: 1;
            }

            .knob .krim {
                left: 0px;
                top: 0px;
                width: 8px;
                height: 20px;
                background-color: #000000;
            }

            .knob .kface {
                left: 1px;
                top: 1px;
                width: 6px;
                height: 16px;
                background-color: #aaaaaa;
            }

            .knob .kshade {
                left: 1px;
                top: 17px;
                width: 6px;
                height: 2px;
                background-color: #565656;
            }

            .btn.track:hover .kface {
                background-color: #bdbdbd;
            }

            .hdr {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffff55;
                white-space: nowrap;
            }

            .tip0 {
                background-color: #100010;
            }

            .tip1 {
                background-color: #2d0a63;
            }

            .tiptx,
            .tipimp {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 10px;
                color: #ffffff;
            }

            .tipimp {
                color: #aaaaaa;
                white-space: nowrap;
            }

            .sbtrack {
                background-color: #000000;
            }

            .sbthumb {
                background-color: #808080;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

        <div id="dim"></div>
        <div id="heading">{{title}}</div>
        {{scene:body}}
    </div>
    </body>
</rml>
