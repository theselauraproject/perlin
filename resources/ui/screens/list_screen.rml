<rml>
    <head>
        <title>list</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            #dim.heavy {
                background-color: rgba(0,0,0,160);
            }

            #scene {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,128);
            }

            #heading {
                left: 0px;
                top: 12px;
                width: 100%;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
                z-index: 3;
            }

            {{include:ui/styles/menu_button.rcss}} .row {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                height: 9px;
                color: #ffffff;
                white-space: nowrap;
            }

            .sub {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                height: 9px;
                color: #a0a0a0;
                white-space: nowrap;
            }

            .head {
                text-align: center;
                color: #ffff55;
            }

            .sep {
                height: 1px;
                background-color: rgba(255,255,255,51);
            }

            .sepb {
                height: 1px;
                background-color: rgba(0,0,0,191);
            }

            .sbtrack {
                background-color: #000000;
            }

            .sbthumb,
            .wthumb {
                background-color: #808080;
            }

            .lpanel {
                background-color: rgba(0,0,0,112);
            }

            .wpanel {
                background-color: #484848;
            }

            .wline {
                background-color: #2e2e2e;
            }

            .wedge {
                background-color: #1e1e1e;
            }

            .wedge.editing {
                background-color: #ffffff;
            }

            .wtrack {
                background-color: #555555;
            }

            .wtrack.on,
            .wseg.on,
            .wfill {
                background-color: #3b8526;
            }

            .wseg {
                background-color: #d0d0d0;
            }

            .wknob0 {
                background-color: #8a8a8a;
            }

            .wknob1 {
                background-color: #d0d0d0;
            }

            .wfield {
                background-color: #313233;
            }

            .wl,
            .wd,
            .seg {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
            }

            .wd {
                color: #a0a0a0;
            }

            .seg {
                text-align: center;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

        <div id="dim" data-attr-class="dim_cls"></div>
        <div id="heading">{{title}}</div>
        {{scene:body}}
    </div>
    </body>
</rml>
