<rml>
    <head>
        <title>screen</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            #scene {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            div,
            mcimg,
            mcitem {
                display: block;
                position: absolute;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            #dim.dim70 {
                background-color: rgba(0,0,0,70);
            }

            #dim.dim140 {
                background-color: rgba(0,0,0,140);
            }

            #dim.dim150 {
                background-color: rgba(0,0,0,150);
            }

            .t {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
            }

            .g {
                color: #a0a0a0;
            }

            .c {
                text-align: center;
            }

            {{include:ui/styles/menu_button.rcss}} .mini {
                background-color: #000000;
            }

            .mini div {
                position: absolute;
            }

            .mini .face {
                left: 1px;
                top: 1px;
                height: 11px;
                background-color: #6f6f6f;
            }

            .mini .lbl {
                font-family: minecraft-shadow;
                left: 0px;
                top: 3px;
                height: 9px;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
            }

            .mini:hover {
                background-color: #ffffff;
            }

            .mini:hover .face {
                background-color: #8a8a8a;
            }

            .mini.off,
            .mini.off:hover {
                background-color: #000000;
            }

            .mini.off .face {
                background-color: #2c2c2c;
            }

            .mini.off .lbl {
                color: #606060;
            }

            .panel {
                overflow: hidden;
                background-color: rgba(0,0,0,170);
            }

            .prow {
                background-color: rgba(0,0,0,0);
            }

            .prow:hover {
                background-color: rgba(255,255,255,40);
            }

            .sel {
                background-color: #000000;
            }

            .sep {
                background-color: rgba(255,255,255,60);
            }

            .sepb {
                background-color: rgba(0,0,0,191);
            }

            .track {
                background-color: #000000;
            }

            .thumb {
                background-color: #808080;
            }

            .wrap {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #a0a0a0;
                white-space: normal;
                overflow: hidden;
            }

            .ico {
                position: absolute;
            }

            .ico .ov {
                display: none;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                background-color: rgba(144,144,144,160);
            }

            .ico:hover .ov {
                display: block;
            }

            .ico .ch,
            .ico .zone {
                display: none;
            }

            .ico:hover .ch {
                display: block;
                background-color: #a0a0a0;
            }

            .ico:hover .zone {
                display: block;
            }

            .zone:hover .ch {
                background-color: #ffffff;
            }

            .srow {
                background-color: rgba(0,0,0,0);
            }

            .srow:hover {
                background-color: rgba(255,255,255,30);
            }

            .noicon {
                background-color: #555555;
            }

            .badge {
                background-color: rgba(0,0,0,150);
            }

            .wrap.open {
                color: #e0e0e0;
                overflow: visible;
            }

            .modframe,
            .frame {
                background-color: #d0d0d0;
            }

            .modframe {
                background-color: #ffffff;
            }

            .listline {
                background-color: rgba(255,255,255,200);
            }

            .listback {
                background-color: rgba(0,0,0,60);
            }

            .listclip {
                overflow: hidden;
            }

            .rowselect {
                background-color: rgba(0,0,0,110);
            }

            .rowtoggle {
                background-color: rgba(0,0,0,150);
            }

            .searchedge {
                background-color: #a0a0a0;
            }

            .searchfill {
                background-color: #000000;
            }

            .progresspanel {
                background-color: rgba(0,0,0,215);
                border-width: 1px;
                border-color: #a0a0a0;
            }

            .progresstrack {
                background-color: #404040;
            }

            .progressfill {
                background-color: #80ff20;
            }

            .cardsel {
                background-color: rgba(255,255,255,34);
            }

            .cardline {
                background-color: #f0f0f0;
            }

            .hintback {
                background-color: rgba(0,0,0,130);
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

        <div id="dim" data-attr-class="dim_cls"></div>
        {{scene:body}}
    </div>
    </body>
</rml>
