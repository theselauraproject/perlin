<rml>
    <head>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                margin: 0;
                padding: 0;
                background-color: #16181f;
            }

            div {
                display: block;
                position: absolute;
            }

            .t {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                height: 9px;
                white-space: nowrap;
                color: #ffffff;
            }

            .c {
                text-align: center;
            }

            .dim {
                color: #9a9ca6;
            }

            .bad {
                color: #ff6b6b;
            }

            .right {
                text-align: right;
            }

            .track {
                height: 5px;
                background-color: #05060a;
            }

            .fill {
                height: 3px;
                background-color: #62d26a;
            }

            .fill.bad {
                background-color: #c84a4a;
            }

            .btn {
                height: 20px;
                background-color: #000000;
                z-index: 5;
            }

            .btn div {
                position: absolute;
            }

            .btn .face {
                left: 1px;
                top: 1px;
                height: 18px;
                background-color: #3c3f4a;
            }

            .btn:hover .face {
                background-color: #565a68;
            }

            .btn .lbl {
                left: 0px;
                top: 6px;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
            }
        </style>
    </head>
    <body>
        <div data-model="overlay" data-style-width="w + 'px'" data-style-height="h + 'px'">
            <div
                data-style-width="w + 'px'"
                data-style-height="h + 'px'"
                style="left:0px;top:0px;decorator:vertical-gradient(#1d2230ff #101116ff);"></div>
            <div class="t c" data-style-top="title_y + 'px'" data-style-width="w + 'px'" style="left:0px;">{{title}}</div>
            <div
                class="t c dim"
                data-style-top="subtitle_y + 'px'"
                data-style-width="w + 'px'"
                style="left:0px;">
                {{subtitle}}
            </div>
            <div data-for="r : rows">
                <div
                    class="t"
                    data-style-left="r.x + 'px'"
                    data-style-top="r.label_y + 'px'"
                    data-style-width="r.w + 'px'">
                    {{r.label}}
                </div>
                <div
                    class="t right"
                    data-class-bad="r.failed == '1'"
                    data-class-dim="r.failed != '1'"
                    data-style-left="r.x + 'px'"
                    data-style-top="r.status_y + 'px'"
                    data-style-width="r.w + 'px'">
                    {{r.status}}
                </div>
                <div
                    class="track"
                    data-style-left="r.x + 'px'"
                    data-style-top="r.bar_y + 'px'"
                    data-style-width="r.w + 'px'"></div>
                <div
                    class="fill"
                    data-class-bad="r.failed == '1'"
                    data-style-left="r.fill_x + 'px'"
                    data-style-top="r.fill_y + 'px'"
                    data-style-width="r.fill_w + 'px'"></div>
            </div>
            <div
                data-for="b : buttons"
                class="btn"
                data-attr-id="b.id"
                data-style-left="b.x + 'px'"
                data-style-top="b.y + 'px'"
                data-style-width="b.w + 'px'">
                <div class="face" data-style-width="b.face_w + 'px'"></div>
                <div class="lbl" data-style-width="b.w + 'px'">{{b.label}}</div>
            </div>
        </div>
    </body>
</rml>
