<rml>
    <head>
        <title>keybinds</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            div {
                display: block;
                position: absolute;
            }

            #scene {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,128);
            }

            #heading {
                left: 0px;
                top: 12px;
                width: 100%;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
                z-index: 3;
            }

            #list {
                overflow: hidden;
                background-color: rgba(0,0,0,112);
            }

            {{include:ui/styles/menu_button.rcss}} .row {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                height: 9px;
                color: #ffffff;
                white-space: nowrap;
            }

            .head {
                text-align: center;
            }

            .sep {
                height: 1px;
                background-color: rgba(255,255,255,51);
            }

            .sepb {
                height: 1px;
                background-color: rgba(0,0,0,191);
            }

            .track {
                background-color: rgba(0,0,0,255);
                width: 6px;
            }

            .thumb {
                background-color: #808080;
                width: 6px;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

        <div id="dim"></div>
        <div id="heading">{{title}}</div>
        {{scene:body}}
    </div>
    </body>
</rml>
