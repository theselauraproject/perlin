<rml>
    <head>
        <title>pause</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            #scene {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            div,
            mcimg {
                display: block;
                position: absolute;
            }

            mcitem {
                display: block;
                position: absolute;
            }

            mcimg {
                display: block;
                position: absolute;
            }

            #dim {
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                background-color: rgba(0,0,0,64);
            }

            #heading {
                left: 0px;
                top: 40px;
                width: 100%;
                height: 9px;
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                text-align: center;
                color: #ffffff;
                white-space: nowrap;
                z-index: 3;
            }

            {{include:ui/styles/menu_button.rcss}} #pp {
                background-color: #000000;
            }

            .ppa {
                background-color: #c6c6c6;
            }

            .ppb {
                background-color: #ffffff;
            }

            .ppc {
                background-color: #373737;
            }

            .pptitle,
            .ppname,
            .pprole {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
            }

            .pptitle {
                text-align: center;
            }

            .ppname {
                overflow: hidden;
            }

            .pprole {
                text-align: right;
            }

            {{include:ui/styles/java_widget_style.rcss}}
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay">

        <div id="dim"></div>
        <div id="heading">{{title}}</div>
        <div id="resume" class="btn" data-style-left="x1 + 'px'" data-style-top="y1 + 'px'" style="width: 204px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 204px;">{{back}}</div>
        </div>
        <div id="feedback" class="btn" data-style-left="x1 + 'px'" data-style-top="y2 + 'px'" style="width: 100px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 100px;">{{feedback}}</div>
        </div>
        <div id="players" class="btn" data-style-left="x2 + 'px'" data-style-top="y2 + 'px'" style="width: 100px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 100px;">{{players}}</div>
        </div>
        <div id="options" class="btn" data-style-left="x1 + 'px'" data-style-top="y3 + 'px'" style="width: 100px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 100px;">{{options}}</div>
        </div>
        <div id="wardrobe" class="btn" data-style-left="xw + 'px'" data-style-top="y3 + 'px'" style="width: 20px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <mcimg
                src="textures/ui/glyph_skin_pack.png"
                style="left: 4px; top: 4px; width: 12px; height: 12px; z-index: 3;" />
        </div>
        <div id="world" class="btn" data-style-left="xr + 'px'" data-style-top="y3 + 'px'" style="width: 100px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 100px;">{{world}}</div>
        </div>
        <div id="mods" class="btn" data-style-left="x1 + 'px'" data-style-top="y4 + 'px'" style="width: 204px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 204px;">{{mods}}</div>
        </div>
        <div id="quit" class="btn" data-style-left="x1 + 'px'" data-style-top="y6 + 'px'" style="width: 204px;">
            {{include:ui/components/java_widget_sprites.rml}}
            <div class="lbl" style="width: 204px;">{{quit}}</div>
        </div>
        {{scene:extra}}
    </div>
    </body>
</rml>
