            class="fill"
            data-style-decorator="n1.decorator == '' ? 'none' : n1.decorator"></div>
        <div data-if="n1.kind == 6" class="ul"></div>
        <div data-if="n1.kind == 8" class="rim" data-style-width="(n1.w - 3) + 'px'"></div>
        <div data-if="n1.kind == 8" class="face" data-style-width="(n1.w - 4) + 'px'"></div>
        <div data-if="n1.kind == 8" class="shade" data-style-width="(n1.w - 2) + 'px'"></div>
        <div data-if="n1.kind == 8" class="edge" data-style-left="(n1.w - 2) + 'px'"></div>
        <div data-if="n1.kind == 8" class="lbl" data-style-width="n1.w + 'px'">
