                            <div data-if="n6.kind == 8" class="rim" data-style-width="(n6.w - 3) + 'px'"></div>
                            <div data-if="n6.kind == 8" class="face" data-style-width="(n6.w - 4) + 'px'"></div>
                            <div data-if="n6.kind == 8" class="shade" data-style-width="(n6.w - 2) + 'px'"></div>
                            <div data-if="n6.kind == 8" class="edge" data-style-left="(n6.w - 2) + 'px'"></div>
                            <div data-if="n6.kind == 8" class="lbl" data-style-width="n6.w + 'px'">
                                <span data-for="n6b : n6.runs">
                                    <span data-if="n6b.colored == '1'">
                                        <span
                                            data-style-color="n6b.color == '' ? '#ffffff' : n6b.color"
                                            data-style-font-weight="n6b.weight"
                                            data-style-font-style="n6b.style"
                                            data-style-background-color="n6b.background"
                                            data-style-display="n6b.display"
                                            data-style-width="n6b.width"
                                            data-style-overflow="n6b.overflow">
                                            {{n6b.text}}
                                        </span>
                                    </span>
                                    <span data-if="n6b.colored != '1'">
                                        <span
                                            data-style-font-weight="n6b.weight"
                                            data-style-font-style="n6b.style"
                                            data-style-background-color="n6b.background"
                                            data-style-display="n6b.display"
                                            data-style-width="n6b.width"
                                            data-style-overflow="n6b.overflow">
                                            {{n6b.text}}
                                        </span>
                                    </span>
                                </span>
                            </div>
                            <div data-if="n6.kind == 9" class="rim" data-style-width="(n6.w - 3) + 'px'"></div>
                            <div data-if="n6.kind == 9" class="face" data-style-width="(n6.w - 4) + 'px'"></div>
                            <div
                                data-if="n6.kind == 9"
                                class="lbl"
                                data-style-width="n6.w + 'px'"
                                style="z-index: 2;">
                                <span data-for="n6s : n6.runs">
                                    <span data-if="n6s.colored == '1'">
                                        <span
                                            data-style-color="n6s.color == '' ? '#ffffff' : n6s.color"
                                            data-style-font-weight="n6s.weight"
                                            data-style-font-style="n6s.style"
                                            data-style-background-color="n6s.background"
                                            data-style-display="n6s.display"
                                            data-style-width="n6s.width"
                                            data-style-overflow="n6s.overflow">
                                            {{n6s.text}}
                                        </span>
                                    </span>
                                    <span data-if="n6s.colored != '1'">
                                        <span
                                            data-style-font-weight="n6s.weight"
                                            data-style-font-style="n6s.style"
                                            data-style-background-color="n6s.background"
                                            data-style-display="n6s.display"
                                            data-style-width="n6s.width"
                                            data-style-overflow="n6s.overflow">
                                            {{n6s.text}}
                                        </span>
                                    </span>
                                </span>
                            </div>
                            <div
                                data-if="n6.kind == 9"
                                class="knob"
                                data-style-left="n6.knob + 'px'"
                                style="top: 0px;">
                                <div class="krim"></div>
                                <div class="kface"></div>
                                <div class="kshade"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
