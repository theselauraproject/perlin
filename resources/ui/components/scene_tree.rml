                        data-style-background-color="n1b.background"
                        data-style-display="n1b.display"
                        data-style-width="n1b.width"
                        data-style-overflow="n1b.overflow">
                        {{n1b.text}}
                    </span>
                </span>
            </span>
        </div>
        <div data-if="n1.kind == 9" class="rim" data-style-width="(n1.w - 3) + 'px'"></div>
        <div data-if="n1.kind == 9" class="face" data-style-width="(n1.w - 4) + 'px'"></div>
        <div data-if="n1.kind == 9" class="lbl" data-style-width="n1.w + 'px'" style="z-index: 2;">
            <span data-for="n1s : n1.runs">
