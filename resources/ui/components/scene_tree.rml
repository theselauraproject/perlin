<div
    data-for="n : {{list}}"
    data-attr-id="n.id"
    data-attr-class="'n ' + n.cls"
    data-style-left="n.x + 'px'"
    data-style-top="n.y + 'px'"
    data-style-width="n.w > 0 ? n.w + 'px' : 'auto'"
    data-style-height="n.h > 0 ? n.h + 'px' : 'auto'"
    data-style-z-index="n.z"
    data-attr-snd="n.snd"
    data-attr-vol="n.vol"
    data-attr-pit="n.pit">
    <mcimg
        data-if="n.kind == 1"
        data-attr-src="n.src"
        data-attr-uv="n.uv"
        data-attr-nine="n.nine"
        data-attr-tiled="n.tiled"
        data-attr-tilescale="n.tileScale"
        data-attr-clip="n.clipDirection"
        data-attr-color="n.tint"
        data-attr-alpha="n.alpha"
        data-attr-keep="n.keep"></mcimg>
    <mcitem data-if="n.kind == 2" data-attr-key="n.key" data-attr-alpha="n.alpha" data-attr-glint="n.glint"></mcitem>
    <div
        data-if="n.kind == 3"
        class="tx"
        data-style-font-family="n.family"
        data-style-font-size="n.size + 'px'"
        data-style-line-height="n.lineHeight + 'px'"
        data-style-text-align="n.align"
        data-style-color="n.color == '' ? '#ffffff' : n.color">
        <span data-for="nr : n.runs">
            <span data-if="nr.colored == '1'">
                <span
                    data-style-color="nr.color == '' ? '#ffffff' : nr.color"
                    data-style-font-weight="nr.weight"
                    data-style-font-style="nr.style"
                    data-style-background-color="nr.background"
                    data-style-display="nr.display"
                    data-style-width="nr.width"
                    data-style-overflow="nr.overflow">
                    {{nr.text}}
                </span>
            </span>
            <span data-if="nr.colored != '1'">
                <span
                    data-style-font-weight="nr.weight"
                    data-style-font-style="nr.style"
                    data-style-background-color="nr.background"
                    data-style-display="nr.display"
                    data-style-width="nr.width"
                    data-style-overflow="nr.overflow">
                    {{nr.text}}
                </span>
            </span>
        </span>
    </div>
    <div data-if="n.kind == 7" class="lab">
        <span data-for="nl : n.runs">
            <span data-if="nl.colored == '1'">
                <span
                    data-style-color="nl.color == '' ? '#ffffff' : nl.color"
                    data-style-font-weight="nl.weight"
                    data-style-font-style="nl.style"
                    data-style-background-color="nl.background"
                    data-style-display="nl.display"
                    data-style-width="nl.width"
                    data-style-overflow="nl.overflow">
                    {{nl.text}}
                </span>
            </span>
            <span data-if="nl.colored != '1'">
                <span
                    data-style-font-weight="nl.weight"
                    data-style-font-style="nl.style"
                    data-style-background-color="nl.background"
                    data-style-display="nl.display"
                    data-style-width="nl.width"
                    data-style-overflow="nl.overflow">
                    {{nl.text}}
                </span>
            </span>
        </span>
    </div>
    <div data-if="n.kind == 4" class="fill" data-style-background-color="n.color"></div>
    <div data-if="n.kind == 5" class="fill" data-style-decorator="n.decorator == '' ? 'none' : n.decorator"></div>
    <div data-if="n.kind == 6" class="ul"></div>
    <div data-if="n.kind == 8" class="rim" data-style-width="(n.w - 3) + 'px'"></div>
    <div data-if="n.kind == 8" class="face" data-style-width="(n.w - 4) + 'px'"></div>
    <div data-if="n.kind == 8" class="shade" data-style-width="(n.w - 2) + 'px'"></div>
    <div data-if="n.kind == 8" class="edge" data-style-left="(n.w - 2) + 'px'"></div>
    <div data-if="n.kind == 8" class="lbl" data-style-width="n.w + 'px'">
        <span data-for="nb : n.runs">
            <span data-if="nb.colored == '1'">
                <span
                    data-style-color="nb.color == '' ? '#ffffff' : nb.color"
                    data-style-font-weight="nb.weight"
                    data-style-font-style="nb.style"
                    data-style-background-color="nb.background"
                    data-style-display="nb.display"
                    data-style-width="nb.width"
                    data-style-overflow="nb.overflow">
                    {{nb.text}}
                </span>
            </span>
            <span data-if="nb.colored != '1'">
                <span
                    data-style-font-weight="nb.weight"
                    data-style-font-style="nb.style"
                    data-style-background-color="nb.background"
                    data-style-display="nb.display"
                    data-style-width="nb.width"
                    data-style-overflow="nb.overflow">
                    {{nb.text}}
                </span>
            </span>
        </span>
    </div>
    <div data-if="n.kind == 9" class="rim" data-style-width="(n.w - 3) + 'px'"></div>
    <div data-if="n.kind == 9" class="face" data-style-width="(n.w - 4) + 'px'"></div>
    <div data-if="n.kind == 9" class="lbl" data-style-width="n.w + 'px'" style="z-index: 2;">
        <span data-for="ns : n.runs">
            <span data-if="ns.colored == '1'">
                <span
                    data-style-color="ns.color == '' ? '#ffffff' : ns.color"
                    data-style-font-weight="ns.weight"
                    data-style-font-style="ns.style"
                    data-style-background-color="ns.background"
                    data-style-display="ns.display"
                    data-style-width="ns.width"
                    data-style-overflow="ns.overflow">
                    {{ns.text}}
                </span>
            </span>
            <span data-if="ns.colored != '1'">
                <span
                    data-style-font-weight="ns.weight"
                    data-style-font-style="ns.style"
                    data-style-background-color="ns.background"
                    data-style-display="ns.display"
                    data-style-width="ns.width"
                    data-style-overflow="ns.overflow">
                    {{ns.text}}
                </span>
            </span>
        </span>
    </div>
    <div data-if="n.kind == 9" class="knob" data-style-left="n.knob + 'px'" style="top: 0px;">
        <div class="krim"></div>
        <div class="kface"></div>
        <div class="kshade"></div>
    </div>
    <div
        data-for="n1 : n.children"
        data-attr-id="n1.id"
        data-attr-class="'n ' + n1.cls"
        data-style-left="n1.x + 'px'"
        data-style-top="n1.y + 'px'"
        data-style-width="n1.w > 0 ? n1.w + 'px' : 'auto'"
        data-style-height="n1.h > 0 ? n1.h + 'px' : 'auto'"
        data-style-z-index="n1.z"
        data-attr-snd="n1.snd"
        data-attr-vol="n1.vol"
        data-attr-pit="n1.pit">
        <mcimg
            data-if="n1.kind == 1"
            data-attr-src="n1.src"
            data-attr-uv="n1.uv"
            data-attr-nine="n1.nine"
            data-attr-tiled="n1.tiled"
            data-attr-tilescale="n1.tileScale"
            data-attr-clip="n1.clipDirection"
            data-attr-color="n1.tint"
            data-attr-alpha="n1.alpha"
            data-attr-keep="n1.keep"></mcimg>
        <mcitem
            data-if="n1.kind == 2"
            data-attr-key="n1.key"
            data-attr-alpha="n1.alpha"
            data-attr-glint="n1.glint"></mcitem>
        <div
            data-if="n1.kind == 3"
            class="tx"
            data-style-font-family="n1.family"
            data-style-font-size="n1.size + 'px'"
            data-style-line-height="n1.lineHeight + 'px'"
            data-style-text-align="n1.align"
            data-style-color="n1.color == '' ? '#ffffff' : n1.color">
            <span data-for="n1r : n1.runs">
                <span data-if="n1r.colored == '1'">
                    <span
                        data-style-color="n1r.color == '' ? '#ffffff' : n1r.color"
                        data-style-font-weight="n1r.weight"
                        data-style-font-style="n1r.style"
                        data-style-background-color="n1r.background"
                        data-style-display="n1r.display"
                        data-style-width="n1r.width"
                        data-style-overflow="n1r.overflow">
                        {{n1r.text}}
                    </span>
                </span>
                <span data-if="n1r.colored != '1'">
                    <span
                        data-style-font-weight="n1r.weight"
                        data-style-font-style="n1r.style"
                        data-style-background-color="n1r.background"
                        data-style-display="n1r.display"
                        data-style-width="n1r.width"
                        data-style-overflow="n1r.overflow">
                        {{n1r.text}}
                    </span>
                </span>
            </span>
        </div>
        <div data-if="n1.kind == 7" class="lab">
            <span data-for="n1l : n1.runs">
                <span data-if="n1l.colored == '1'">
                    <span
                        data-style-color="n1l.color == '' ? '#ffffff' : n1l.color"
                        data-style-font-weight="n1l.weight"
                        data-style-font-style="n1l.style"
