            data-style-left="n2.x + 'px'"
            data-style-top="n2.y + 'px'"
            data-style-width="n2.w > 0 ? n2.w + 'px' : 'auto'"
            data-style-height="n2.h > 0 ? n2.h + 'px' : 'auto'"
            data-style-z-index="n2.z"
            data-attr-snd="n2.snd"
