                        data-style-font-style="n1l.style"
                        data-style-background-color="n1l.background"
                        data-style-display="n1l.display"
                        data-style-width="n1l.width"
                        data-style-overflow="n1l.overflow">
                        {{n1l.text}}
                    </span>
