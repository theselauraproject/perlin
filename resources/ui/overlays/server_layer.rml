<rml>
    <head>
        <title>server</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                margin: 0;
                padding: 0;
                background: transparent;
                overflow: hidden;
            }

            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                overflow: hidden;
            }

            div {
                display: block;
                position: absolute;
            }

            .t {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                white-space: nowrap;
                color: #ffffff;
            }

            .c {
                text-align: center;
            }

            .r {
                text-align: right;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="server" data-style-width="w + 'px'" data-style-height="h + 'px'">
            {{scene:body}}
        </div>
    </body>
</rml>
