<rml>
    <head>
        <title>replay</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
            }

            div {
                display: block;
                position: absolute;
            }

            {{include:ui/styles/menu_button.rcss}} .btn:hover .shade {
                background-color: #5c5c5c;
            }

            .btn.on .face {
                background-color: #4c7a2f;
            }

            .btn.on .rim {
                background-color: #7fb85a;
            }

            .btn.off .rim,
            .btn.off .face,
            .btn.off .shade {
                background-color: #2c2c2c;
            }

            .txt {
                font-family: minecraft-shadow;
                font-size: 8px;
                line-height: 9px;
                color: #ffffff;
                white-space: nowrap;
            }

            .gray {
                color: #aaaaaa;
            }

            .yellow {
                color: #ffff55;
            }

            .green {
                color: #55ff55;
            }

            .right {
                text-align: right;
            }

            .center {
                text-align: center;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="overlay" data-style-width="w + 'px'" data-style-height="h + 'px'">

        <mclayer data-if="layer_export" layer="export" style="display: block; position: absolute; width: 0px; height: 0px; z-index: -999;"></mclayer>
        {{scene:body}}
        <mclayer data-if="layer_gui" layer="gui" style="display: block; position: absolute; width: 0px; height: 0px; z-index: 999;"></mclayer>
    </div>
    </body>
</rml>
