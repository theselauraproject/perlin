<rml>
    <head>
        <title>plugins</title>
        <style>
            body {
                position: absolute;
                left: 0px;
                top: 0px;
                margin: 0;
                padding: 0;
                background: transparent;
                overflow: hidden;
            }

            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                overflow: hidden;
            }

            div,
            mcimg,
            mcitem {
                display: block;
                position: absolute;
            }
        </style>
    </head>
    <body>
        <div id="scene" data-model="plugin" data-style-width="w + 'px'" data-style-height="h + 'px'">
            {{scene:body}}
        </div>
    </body>
</rml>
