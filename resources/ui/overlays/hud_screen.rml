<rml>
    <head>
        <title>hud</title>
        <style>
            {{engine_css}} body {
                position: absolute;
                left: 0px;
                top: 0px;
                width: {{w}}px;
                height: {{h}}px;
                margin: 0;
                padding: 0;
                background: transparent;
            }

            #scene {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
            }

            mcimg,
            mcitem {
                display: block;
                position: absolute;
            }

            .t {
                display: block;
                position: absolute;
                font-family: minecraft;
                white-space: pre;
                overflow: visible;
            }

            .t.s {
                font-family: minecraft-shadow;
            }

            .t.o {
                font-family: minecraft-outline;
            }

            .t.ten {
                font-family: minecraft-ten;
            }

            .t.ten.s {
                font-family: minecraft-ten-shadow;
            }

            .t.ten.o {
                font-family: minecraft-ten-outline;
            }

            #hotbar {
            }

            .hotbar-slot {
            }

            #hotbar-slot-0 {
            }

            #hotbar-slot-1 {
            }

            #hotbar-slot-2 {
            }

            #hotbar-slot-3 {
            }

            #hotbar-slot-4 {
            }

            #hotbar-slot-5 {
            }

            #hotbar-slot-6 {
            }

            #hotbar-slot-7 {
            }

            #hotbar-slot-8 {
            }

            .hotbar-item {
            }

            #hotbar-start-cap {
            }

            #hotbar-end-cap {
            }

            #hearts {
            }

            #horse-hearts {
            }

            #armor {
            }

            #hunger {
            }

            #air {
            }

            #xp-bar {
            }

            #item-name {
            }

            #actionbar {
            }

            #title {
            }

            #subtitles {
            }

            #effects {
            }

            #bossbars {
            }

            #scoreboard {
            }

            {{chat_style}}
{{rcss}}
        </style>
    </head>
    <body>
        <div id="scene" data-model="document">
            {{hud}}
{{chat}}
        </div>
    </body>
</rml>
