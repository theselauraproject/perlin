<rml>
    <head>
        <title>chat</title>
        <style>
            #chat-lines {
                display: block;
                position: absolute;
                left: 0px;
                top: {{chat_top}}px;
                width: {{chat_w}}px;
                height: 180px;
                z-index: 30;
            }

            .link {
                display: block;
                position: absolute;
            }

            .link .ul {
                display: none;
                position: absolute;
                left: 0px;
                bottom: 0px;
                width: 100%;
                height: 1px;
                background-color: #ffff55;
            }

            .link:hover .ul {
                display: block;
            }

            #chat-scroll {
                display: block;
                position: absolute;
                left: 0px;
                top: {{chat_top}}px;
                width: 2px;
                height: 180px;
                z-index: 31;
            }

            #chat-input {
                display: block;
                position: absolute;
                left: 2px;
                top: {{input_top}}px;
                width: {{input_w}}px;
                height: 12px;
                z-index: 32;
            }
        </style>
    </head>
    <body>
        <div id="chat-lines">{{lines}}</div>
        <div id="chat-scroll">{{scrollbar}}</div>
        <div id="chat-input">{{input}}</div>
    </body>
</rml>
